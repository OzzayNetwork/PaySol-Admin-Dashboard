# PaySol Admin API base URL
#
# This is the PUBLIC reference prefix. It matches the `apiUrl` variable in
# docs/postman/PaySol-Admin-API.postman_collection.json.
#   - /api/v1/countries, /counties, /banks ...        -> public reference data
#
# Admin console routes add /admin on top of it, which api/index.js does for you
# via `adminClient` (see that file). Do NOT put /admin here.
#
# Requires `php artisan serve` to be running in the Laravel project.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production (deploy) — uncomment/set when deploying
# VITE_API_BASE_URL=https://api.paysol.com/api/v1

# Google Maps API key (used by Gallery map page)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyBl3dCvpVQUs04SOTCHgITw4Ts79-dRcfI

# Gemini API key (for possible AI features)
VITE_GEMINI_API_KEY=AIzaSyDJUn7UEia1bOxfFYac87FlZ3LtElfEJIw
