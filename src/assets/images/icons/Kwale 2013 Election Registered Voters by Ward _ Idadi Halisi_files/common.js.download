rc="{photo.url}"\n            {block:photo.width} width="{photo.width}" {/block:photo.width}\n            {block:photo.height} height="{photo.height}" {/block:photo.height}\n            {block:photo.alt} alt="{photo.alt}" {/block:photo.alt} />\n      </a>\n    </dd>\n    {/block:Ifphoto.url}\n  {/block:Ifphoto}\n  {block:showlocation}\n  <dd class="profile-location">\n    {location}\n  </dd>\n  {/block:showlocation}\n  {block:showoccupation}\n  <dd class="profile-occupation">\n    {occupation}\n  </dd>\n  {/block:showoccupation}\n  {block:showaboutme}\n  <dd class="profile-aboutme">{aboutme}</dd>\n  {/block:showaboutme}\n</dl>\n{/template:ProfileGadgetPersonal}\n\n{template:ProfileGadgetTeam}\n<ul class="profile-data-list">\n  {block:authors}\n  <li><a href="{userUrl}" class="profile-name-link g-profile"\n      style="background-image: url(\'{profileLogo}\');">{display-name}</a></li>\n  {/block:authors}\n</ul>\n{/template:ProfileGadgetTeam}\n\n{template:ProfileGadgetDefaultIcon}\ndata:image/png;base64,\n{/template:ProfileGadgetDefaultIcon}\n\n{template:ProfileGadgetDefaultIconSelected}\ndata:image/png;base64,\n{/template:ProfileGadgetDefaultIconSelected}\n');function Yp(a){Z.call(this,a)}D(Yp,Z);B=Yp.prototype;B.init=function(a,b){this.ui=a;a=document.querySelector(Gb);var c=a.querySelector("#profilecss");c&&c.remove();c=document.createElement(sc);c.setAttribute(Mb,"profilecss");c.setAttribute(eb,nc);c.append(this.template("ProfileCSS"));a.append(c);this.ea(b,"Profile"+this.N)};B.L=function(){return this.C.title||"Profile"};B.Z=function(){return this.C.photo&&this.C.photo.url||this.template("ProfileGadgetDefaultIcon")};
